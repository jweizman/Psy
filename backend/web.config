<?xml version="1.0" encoding="utf-8"?>
<!--
  Template web.config for IIS hosting. `dotnet publish` will update
  <handlers> and the <aspNetCore> processPath / arguments / hostingModel
  automatically; the <environmentVariables> block below is preserved.
  Replace REPLACE_ME with your real Anthropic key, or remove that line
  and set Anthropic:ApiKey in appsettings.Production.json.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Psy.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="ANTHROPIC_API_KEY" value="REPLACE_ME" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
